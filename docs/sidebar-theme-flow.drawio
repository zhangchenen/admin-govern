<mxfile host="drawio"><diagram name="侧边栏换肤流程"><mxGraphModel page="1" pageWidth="1040" pageHeight="970"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" value="1. 用户选择主题色 / 明暗模式&lt;br&gt;Navbar → Theme Store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Microsoft YaHei;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="310" y="70" width="420" height="80" /></mxCell><mxCell id="3" value="2. 得到侧边栏真实底色&lt;br&gt;浅色：主色；暗色：主色压暗 25%" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#64748b;fontFamily=Microsoft YaHei;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="310" y="200" width="420" height="90" /></mxCell><mxCell id="4" value="3. 比较黑字 / 白字的清晰度&lt;br&gt;同时检查普通、悬停、选中、选中悬停" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#64748b;fontFamily=Microsoft YaHei;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="310" y="340" width="420" height="100" /></mxCell><mxCell id="5" value="4. 统一文字色，必要时减轻黑色遮罩&lt;br&gt;文字不随鼠标悬停来回切换黑白" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#64748b;fontFamily=Microsoft YaHei;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="310" y="490" width="420" height="90" /></mxCell><mxCell id="6" value="5. 写入全局 CSS 变量&lt;br&gt;sidebar-bg / text / hover / active" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Microsoft YaHei;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="310" y="630" width="420" height="90" /></mxCell><mxCell id="7" value="6A. Tailwind 接入&lt;br&gt;bg-sidebar + text-sidebar-text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#64748b;fontFamily=Microsoft YaHei;fontSize=17;spacing=12;" vertex="1" parent="1"><mxGeometry as="geometry" x="40" y="780" width="420" height="90" /></mxCell><mxCell id="8" value="6B. Element Plus 接入&lt;